<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.oracle.coherence.hibernate</groupId>
        <artifactId>coherence-hibernate-parent</artifactId>
        <version>4.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>coherence-hibernate-packaging-tests</artifactId>
    <packaging>pom</packaging>
    <name>Coherence Hibernate Packaged Security Tests</name>
    <properties>
        <coherence.hibernate.root>${basedir}/..</coherence.hibernate.root>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.oracle.coherence.hibernate</groupId>
            <artifactId>coherence-hibernate-cache-7</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- These dependencies enforce reactor ordering, including parallel builds.
             Tests inspect the final files, never classes from executable sample JARs. -->
        <dependency>
            <groupId>com.oracle.coherence.hibernate</groupId>
            <artifactId>coherence-hibernate-demo-app</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.oracle.coherence.hibernate</groupId>
            <artifactId>coherence-hibernate-demo-server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.oracle.coherence.hibernate</groupId>
            <artifactId>coherence-hibernate-cache-store-demo-parent</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>${coherence.groupId}</groupId>
            <artifactId>coherence</artifactId>
            <version>${coherence.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate7.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${hibernate7.junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-packaging-tests</id>
                        <phase>test-compile</phase>
                        <goals><goal>testCompile</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>packaged-security</id>
                        <phase>package</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes><include>**/*PackagingIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>com.oracle.coherence.hibernate:coherence-hibernate-demo-app</classpathDependencyExclude>
                                <classpathDependencyExclude>com.oracle.coherence.hibernate:coherence-hibernate-demo-server</classpathDependencyExclude>
                                <classpathDependencyExclude>com.oracle.coherence.hibernate:coherence-hibernate-cache-store-demo-parent</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <systemPropertyVariables>
                                <project.root>${coherence.hibernate.root}</project.root>
                                <project.version>${project.version}</project.version>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration><skip>true</skip></configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.plugins</groupId>
                <artifactId>nexus-staging-maven-plugin</artifactId>
                <configuration><skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo></configuration>
            </plugin>
        </plugins>
    </build>
</project>
